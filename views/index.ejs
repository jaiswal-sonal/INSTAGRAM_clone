<% include ./partials/header.ejs %>
  <div class="auth">
    <div class="auth-card">
      <img class="auth-logo" src="/images/logo.png" alt="Instagram">
      <p class="auth-sub">Sign up to see photos from your friends.</p>
      <form action="/register" method="post">
        <input class="field" type="email" placeholder="Email" name="email" required>
        <input class="field" type="text" placeholder="Full name" name="name" required>
        <input class="field" type="text" placeholder="Username" name="username" required>
        <input class="field" type="password" placeholder="Password" name="password" required>
        <button class="btn btn-blue" type="submit">Sign up</button>
      </form>
    </div>
    <div class="auth-card auth-alt">Have an account? <a href="/login">Log in</a></div>
  </div>
<% include ./partials/footer.ejs %>
