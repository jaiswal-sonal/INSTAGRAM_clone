<% include ./partials/header.ejs %>
  <div class="m-top">
    <h1><%= user.username %></h1>
    <div class="m-icons">
      <button type="button" class="theme-toggle" aria-label="Switch appearance"><i class="ri-moon-line"></i></button>
      <a href="/upload" aria-label="Create"><i class="ri-add-box-line"></i></a>
      <a href="/logout" aria-label="Log out"><i class="ri-logout-box-r-line"></i></a>
    </div>
  </div>

  <div class="profile">
    <header class="pf-head">
      <div class="pf-avatar"><img src="/images/uploads/<%= user.picture %>" alt="<%= user.username %>"></div>
      <div class="pf-info">
        <div class="pf-row1">
          <h2 class="pf-username"><%= user.username %></h2>
          <a class="btn" href="/edit">Edit profile</a>
        </div>
        <ul class="pf-stats">
          <li><b><%= user.posts.length %></b> <%= user.posts.length === 1 ? "post" : "posts" %></li>
          <li><b><%= user.followers.length %></b> <%= user.followers.length === 1 ? "follower" : "followers" %></li>
          <li><b><%= user.following.length %></b> following</li>
        </ul>
        <div class="pf-bio">
          <b><%= user.name %></b>
          <% if(user.bio){ %>
            <p><%= user.bio %></p>
          <% } else { %>
            <a href="/edit">Add a bio</a>
          <% } %>
        </div>
      </div>
    </header>

    <div class="pf-tabs">
      <button class="pf-tab active" data-target="grid-posts"><i class="ri-grid-line"></i> POSTS</button>
      <button class="pf-tab" data-target="grid-saved"><i class="ri-bookmark-line"></i> SAVED</button>
    </div>

    <div id="grid-posts">
      <% if(user.posts.length>0){ %>
        <div class="pf-grid">
          <% user.posts.reverse().forEach(function(post){ %>
            <div class="pf-item">
              <img src="/images/uploads/<%= post.picture %>" alt="">
              <div class="pf-ov"><i class="ri-heart-3-fill"></i> <%= post.like.length %></div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty">
          <div class="ring"><i class="ri-camera-line"></i></div>
          <h2>Share photos</h2>
          <p>When you share photos, they will appear on your profile.</p>
          <a class="link-blue" href="/upload">Share your first photo</a>
        </div>
      <% } %>
    </div>

    <div id="grid-saved" hidden>
      <% if(user.saved.length>0){ %>
        <div class="pf-grid">
          <% user.saved.forEach(function(post){ %>
            <div class="pf-item">
              <img src="/images/uploads/<%= post.picture %>" alt="">
              <div class="pf-ov"><i class="ri-heart-3-fill"></i> <%= post.like.length %></div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty">
          <div class="ring"><i class="ri-bookmark-line"></i></div>
          <h2>Nothing saved yet</h2>
          <p>Tap the bookmark on a post to save it here. Only you can see what you save.</p>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    document.querySelectorAll(".pf-tab").forEach(function (tab) {
      tab.addEventListener("click", function () {
        document.querySelectorAll(".pf-tab").forEach(function (t) {
          t.classList.toggle("active", t === tab);
          document.getElementById(t.dataset.target).hidden = t !== tab;
        });
      });
    });
  </script>
<% include ./partials/footer.ejs %>
