<% include ./partials/header.ejs %>
  <div class="auth">
    <div class="auth-card">
      <img class="auth-logo" src="/images/logo.png" alt="Instagram">
      <form action="/login" method="post">
        <input class="field" type="text" placeholder="Username" name="username" required>
        <input class="field" type="password" placeholder="Password" name="password" required>
        <button class="btn btn-blue" type="submit">Log in</button>
      </form>
    </div>
    <div class="auth-card auth-alt">Don't have an account? <a href="/">Sign up</a></div>
  </div>
<% include ./partials/footer.ejs %>
