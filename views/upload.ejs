<% include ./partials/header.ejs %>
  <div class="m-top">
    <a href="/feed" aria-label="Back"><i class="ri-close-line"></i></a>
    <h1>New post</h1>
    <span style="width:24px"></span>
  </div>

  <div class="create-card">
    <div class="create-head">
      <span style="width:48px"></span>
      <h1>Create new post</h1>
      <button type="submit" form="uploadform" id="sharebtn" class="link-blue" disabled>Share</button>
    </div>

    <form id="uploadform" action="/post" enctype="multipart/form-data" method="post">
      <div class="create-drop">
        <div class="prompt" id="prompt">
          <i class="ri-image-add-line"></i>
          <p>Select a photo to share</p>
          <button type="button" id="selectpic" class="btn btn-blue">Select from computer</button>
        </div>
        <img class="preview" id="preview" alt="Selected photo" hidden>
      </div>

      <div class="seg">
        <input type="radio" id="cat-post" name="category" value="post" checked>
        <label for="cat-post">Post</label>
        <input type="radio" id="cat-story" name="category" value="story">
        <label for="cat-story">Story</label>
      </div>

      <input id="imageinp" hidden type="file" name="image" accept="image/*">
      <textarea id="caption" name="caption" placeholder="Write a caption..."></textarea>
    </form>
  </div>

  <script>
    var fileInp = document.getElementById("imageinp");
    var preview = document.getElementById("preview");
    var prompt_ = document.getElementById("prompt");
    var shareBtn = document.getElementById("sharebtn");

    document.getElementById("selectpic").addEventListener("click", function () { fileInp.click(); });
    preview.addEventListener("click", function () { fileInp.click(); });

    fileInp.addEventListener("change", function () {
      var f = fileInp.files[0];
      if (!f) { shareBtn.disabled = true; return; }
      var reader = new FileReader();
      reader.onload = function (e) {
        preview.src = e.target.result;
        preview.hidden = false;
        prompt_.hidden = true;
      };
      reader.readAsDataURL(f);
      shareBtn.disabled = false;
    });

    // stories have no caption
    document.querySelectorAll("input[name=category]").forEach(function (r) {
      r.addEventListener("change", function () {
        document.getElementById("caption").hidden = document.getElementById("cat-story").checked;
      });
    });
  </script>
<% include ./partials/footer.ejs %>
