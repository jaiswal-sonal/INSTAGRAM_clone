<% include ./partials/header.ejs %>
  <div class="m-top">
    <img class="m-logo" src="/images/logo.png" alt="Instagram">
    <div class="m-icons">
      <button type="button" class="theme-toggle" aria-label="Switch appearance"><i class="ri-moon-line"></i></button>
      <a href="/upload" aria-label="Create"><i class="ri-add-box-line"></i></a>
      <a href="/logout" aria-label="Log out"><i class="ri-logout-box-r-line"></i></a>
    </div>
  </div>

  <div class="feed-wrap">
    <div class="feed-col">
      <div class="stories">
        <a class="story-item" href="/upload" title="Add to your story">
          <div class="story-ring"><div class="inner"><img src="/images/uploads/<%= user.picture %>" alt=""></div></div>
          <div class="story-name">Your story</div>
        </a>
        <% stories.forEach(function(story){ %>
          <a class="story-item" href="/story/<%= story.id %>">
            <div class="story-ring"><div class="inner"><img src="/images/uploads/<%= story.user.picture %>" alt=""></div></div>
            <div class="story-name"><%= story.user.username %></div>
          </a>
        <% }) %>
      </div>

      <div class="posts parent">
        <% if(posts.length === 0){ %>
          <div class="empty">
            <div class="ring"><i class="ri-camera-line"></i></div>
            <h2>No posts yet</h2>
            <p>Share your first photo and it will show up here.</p>
            <a class="btn btn-blue" href="/upload">Share a photo</a>
          </div>
        <% } %>
        <% posts.reverse().forEach(function(post){ %>
          <article class="post" data-postid="<%= post.id %>">
            <header class="post-head">
              <a class="post-user" href="/profile/<%= post.user.username %>">
                <img class="av av-32" src="/images/uploads/<%= post.user.picture %>" alt="">
                <span><%= post.user.username %></span>
              </a>
              <span class="dot">•</span>
              <time><%= dater(new Date(post.date)) %></time>
            </header>
            <div class="post-media">
              <img class="postimg" src="/images/uploads/<%= post.picture %>" alt="Post by <%= post.user.username %>">
            </div>
            <div class="post-actions">
              <div class="left">
                <button class="icon-btn heart-btn" aria-label="Like">
                  <% if(post.like.indexOf(user._id)===-1){ %>
                    <i class="heart ri-heart-3-line"></i>
                  <% } else { %>
                    <i class="heart ri-heart-3-fill liked"></i>
                  <% } %>
                </button>
                <button class="icon-btn" aria-label="Comment"><i class="ri-chat-3-line"></i></button>
                <button class="icon-btn" aria-label="Share"><i class="ri-send-plane-line"></i></button>
              </div>
              <button class="icon-btn save-btn" aria-label="Save">
                <% if(user.saved.indexOf(post.id)===-1){ %>
                  <i class="save ri-bookmark-line"></i>
                <% } else { %>
                  <i class="save ri-bookmark-fill"></i>
                <% } %>
              </button>
            </div>
            <div class="likeval"><%= post.like.length %> <%= post.like.length === 1 ? "like" : "likes" %></div>
            <% if(post.caption){ %>
              <p class="caption"><b><%= post.user.username %></b><%= post.caption %></p>
            <% } %>
          </article>
        <% }) %>
      </div>
    </div>

    <aside class="feed-rail">
      <div class="rail-me">
        <a href="/profile"><img class="av av-44" src="/images/uploads/<%= user.picture %>" alt=""></a>
        <div class="who">
          <a href="/profile"><b><%= user.username %></b></a>
          <span class="muted"><%= user.name %></span>
        </div>
        <a class="link-blue" href="/logout" style="font-size:12px">Log out</a>
      </div>
      <p class="rail-foot">Instagram clone</p>
    </aside>
  </div>

  <script>
    (function () {
      var feed = document.querySelector(".parent");
      if (!feed) return;

      function isLiked(post) {
        return post.querySelector(".heart").classList.contains("ri-heart-3-fill");
      }
      function paintLike(post, liked) {
        var h = post.querySelector(".heart");
        h.classList.toggle("ri-heart-3-fill", liked);
        h.classList.toggle("ri-heart-3-line", !liked);
        h.classList.toggle("liked", liked);
      }
      function setLike(post, want) {
        if (isLiked(post) === want) return;
        paintLike(post, want);
        fetch("/like/" + post.dataset.postid)
          .then(function (r) { return r.json(); })
          .then(function (res) {
            var n = res.like.length;
            post.querySelector(".likeval").textContent = n + (n === 1 ? " like" : " likes");
          })
          .catch(function () { paintLike(post, !want); });
      }
      function burst(media) {
        var h = document.createElement("i");
        h.className = "ri-heart-3-fill burst";
        media.appendChild(h);
        setTimeout(function () { h.remove(); }, 900);
      }

      // double-click the photo = like (like Instagram)
      feed.addEventListener("dblclick", function (e) {
        if (!e.target.classList.contains("postimg")) return;
        var post = e.target.closest(".post");
        burst(post.querySelector(".post-media"));
        setLike(post, true);
      });

      feed.addEventListener("click", function (e) {
        var post = e.target.closest(".post");
        if (!post) return;

        if (e.target.closest(".heart-btn")) {
          setLike(post, !isLiked(post));
        } else if (e.target.closest(".save-btn")) {
          var icon = post.querySelector(".save");
          var saved = icon.classList.contains("ri-bookmark-fill");
          icon.classList.toggle("ri-bookmark-fill", !saved);
          icon.classList.toggle("ri-bookmark-line", saved);
          fetch("/save/" + post.dataset.postid).catch(function () {
            icon.classList.toggle("ri-bookmark-fill", saved);
            icon.classList.toggle("ri-bookmark-line", !saved);
          });
        }
      });
    })();
  </script>
<% include ./partials/footer.ejs %>
