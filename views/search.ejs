<% include ./partials/header.ejs %>
  <div class="page-narrow">
    <h1 class="page-title">Search</h1>
    <div class="search-box">
      <i class="ri-search-line"></i>
      <input class="input" type="text" placeholder="Search by username" autocomplete="off" aria-label="Search by username">
    </div>
    <div class="users"></div>
  </div>

  <script>
    var inp = document.querySelector(".input");
    var box = document.querySelector(".users");
    var latest = 0;

    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    inp.addEventListener("input", function () {
      var q = inp.value.trim();
      var ticket = ++latest;
      if (q === "") { box.innerHTML = ""; return; }

      fetch("/search/" + encodeURIComponent(q))
        .then(function (raw) { return raw.json(); })
        .then(function (result) {
          if (ticket !== latest) return; // ignore old responses
          if (result.length === 0) {
            box.innerHTML = '<p class="search-note">No users found for "' + esc(q) + '".</p>';
            return;
          }
          box.innerHTML = result.map(function (item) {
            return '<a class="result" href="/profile/' + encodeURIComponent(item.username) + '">' +
              '<img class="av av-44" src="/images/uploads/' + esc(item.picture) + '" alt="">' +
              '<div class="who"><b>' + esc(item.username) + '</b><span class="muted">' + esc(item.name) + '</span></div>' +
              '</a>';
          }).join("");
        })
        .catch(function () {
          if (ticket === latest) box.innerHTML = '<p class="search-note">Something went wrong. Try again.</p>';
        });
    });
  </script>
<% include ./partials/footer.ejs %>
