<% include ./partials/header.ejs %>
  <div class="m-top">
    <a href="/feed" aria-label="Back"><i class="ri-arrow-left-s-line"></i></a>
    <h1><%= userprofile.username %></h1>
    <span style="width:24px"></span>
  </div>

  <div class="profile">
    <header class="pf-head">
      <div class="pf-avatar"><img src="/images/uploads/<%= userprofile.picture %>" alt="<%= userprofile.username %>"></div>
      <div class="pf-info">
        <div class="pf-row1">
          <h2 class="pf-username"><%= userprofile.username %></h2>
          <% if(user.following.indexOf(userprofile._id) === -1){ %>
            <a class="btn btn-blue" href="/follow/<%= userprofile._id %>">Follow</a>
          <% } else { %>
            <a class="btn" href="/follow/<%= userprofile._id %>">Following</a>
          <% } %>
        </div>
        <ul class="pf-stats">
          <li><b><%= userprofile.posts.length %></b> <%= userprofile.posts.length === 1 ? "post" : "posts" %></li>
          <li><b><%= userprofile.followers.length %></b> <%= userprofile.followers.length === 1 ? "follower" : "followers" %></li>
          <li><b><%= userprofile.following.length %></b> following</li>
        </ul>
        <div class="pf-bio">
          <b><%= userprofile.name %></b>
          <% if(userprofile.bio){ %>
            <p><%= userprofile.bio %></p>
          <% } %>
        </div>
      </div>
    </header>

    <div class="pf-tabs single">
      <span class="pf-tab active"><i class="ri-grid-line"></i> POSTS</span>
    </div>

    <% if(userprofile.posts.length>0){ %>
      <div class="pf-grid">
        <% userprofile.posts.reverse().forEach(function(post){ %>
          <div class="pf-item">
            <img src="/images/uploads/<%= post.picture %>" alt="">
            <div class="pf-ov"><i class="ri-heart-3-fill"></i> <%= post.like.length %></div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty">
        <div class="ring"><i class="ri-camera-line"></i></div>
        <h2>No posts yet</h2>
        <p><%= userprofile.username %> has not shared any photos.</p>
      </div>
    <% } %>
  </div>
<% include ./partials/footer.ejs %>
